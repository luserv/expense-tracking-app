{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "electron-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "utils/dbSchema.ts"]
}
